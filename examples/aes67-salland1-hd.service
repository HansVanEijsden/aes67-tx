# Real-world example: publish a network FLAC/IceCast stream as a PTP-synced AES67 L24 source.
# ffmpeg decodes the OGG/FLAC stream to raw 24-bit PCM (ffmpeg scales 16-bit audio to 24-bit
# automatically, so no extra gain is needed) and aes67-tx --raw re-stamps it from the PTP
# clock and emits AES67 on the Dante network. This is how "Salland1 HD Program" is fed when
# the studio cannot yet send Dante/AS67 directly (e.g. no TailScale/Dante at the source).
#
# NOTE: a PCM24 receiver (like this Dante bridge) rejects L16 flows, so we output L24. The raw
# input path swaps little-endian PCM to the big-endian L24 that AES67 requires.
#
# ffmpeg -reconnect keeps reconnecting over short outages; aes67-tx exits on upstream EOF so
# systemd ("Restart=always") re-spawns the whole pipeline to rejoin. Automatic reconnection.
#
# -J <N> is the jitter-buffer depth (in RTP packets): aes67-tx reads ahead this many packets
# from stdin and emits one per media-clock slot.  A bursty live decoder (network FLAC/Ogg)
# delivers data in bursts and gaps; without this the receiver's jitter buffer overflows
# ("Late" spikes / link drops).  256 pkts ~ 256 ms.  Increase it (e.g. -J 512) if your uplink
# stalls for longer; the cost is that much added latency.  aes67-tx stamps timestamps from the
# PTP clock (PTP-locked), which is what a strict AES67/Dante receiver requires.
#
# Adjust the URL, -a/-p (output AES67 group/port) and -f (iface) as needed.
[Unit]
Description=aes67-tx - Salland1 HD Program (Salland1 FLAC to PTP-synced AES67 L24)
After=network-online.target ptp4l-slave-eno1.service
Wants=network-online.target

[Service]
Type=simple
Nice=-10
ExecStart=/bin/bash -c 'ffmpeg -hide_banner -loglevel error -reconnect 1 -reconnect_streamed 1 -reconnect_delay_max 5 -i "https://radio.salland1.nl/salland1-flac" -vn -f s24le -ar 48000 -ac 2 - | /usr/local/bin/aes67-tx --raw -k 0x6a95A511 -a 239.69.100.2 -p 5004 -f eno1 -b 24 -C 2 -n 48 -J 256'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
