# Real-world example: publish a network FLAC/IceCast stream as a PTP-synced AES67 L24 source.
#
# Liquidsoap fetches and decodes the OGG/FLAC stream, then writes raw 24-bit PCM
# to aes67-tx.  aes67-tx 1.6.0 does two things ffmpeg could not:
#   * pace/create the output on the PTP hardware clock (Dante lock), and
#   * hold the input ring at a fixed target latency with *adaptive resampling*,
#     so the remote encoder's clock drift never turns into growing latency or
#     zero-packet hiccups.
#
# IMPORTANT: keep the existing output group/port/PT/SSRC/SDP.  The Dante
# Controller subscription for 239.69.100.2 already exists, so replacing this
# service needs no new SDP import.
#
# Latency: -L 1000 = target 1.0 s, -J 3072 = 3 s ring capacity.  The target is
# the buffered audio inside aes67-tx; Liquidsoap's HTTP input adds its own small
# buffer.  Raise -L/-J for a more forgiving uplink, lower them for less latency.
#
# The service runs as root: aes67-tx must open /dev/ptp0 and the multicast
# socket.  Keep the unit name and output address unchanged so the existing
# aes67-stream-watchdog keeps working.
[Unit]
Description=aes67-tx - Salland1 HD Program (Liquidsoap FLAC -> adaptive resampler -> PTP-synced AES67 L24)
After=network-online.target ptp4l-slave-eno1.service
Wants=network-online.target

[Service]
Type=simple
Nice=-10
ExecStart=/usr/bin/liquidsoap /etc/liquidsoap/aes67-salland1/main.liq
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
