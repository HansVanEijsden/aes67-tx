# Real-world example: publish a source's AES67/RTP stream as a PTP-synced AES67 LED source.
# In this case the source is a broadcast processor (Stereo Tool / LiveWire AES67) and the
# result is a "1Zwolle HD Program" channel on a Dante network (VertoMX -> MADI console).
#
# Adjust -A/-P (source multicast), -a/-p (new AES67 output group/port) and -f (iface).
[Unit]
Description=aes67-tx - 1Zwolle HD Program (Stereo Tool AES67 to PTP-synced AES67)
After=network-online.target ptp4l-slave-eno1.service
Wants=network-online.target

[Service]
Type=simple
Nice=-10
# --relay-buffer 8 enables the paced relay (v1.7.2, fixed in v1.7.3): received
# packets are held in an 8 ms jitter buffer and emitted on PTP slots, so arrival
# jitter from the source/network no longer shows up as "Late" spikes on the
# receiver.  8 ms is the extra program latency; measured on this source, 4 ms
# still underran on occasional >4 ms input gaps while 6 and 8 ms did not.  Use
# 2 ms for minimum latency.  Omit the flag for the legacy arrival-paced relay.
ExecStart=/usr/local/bin/aes67-tx -k 0x6a95A512 -A 239.192.19.137 -P 5004 -a 239.69.100.1 -p 5004 -f eno1 --relay-buffer 8 -v
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
